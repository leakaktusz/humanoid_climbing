<mujoco model="t1 scene">
  <include file="t1.xml"/>

  <statistic center="0.35 0.1 0.7" extent="0.85"/>

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-160" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="0.9 0.9 0.9"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <!-- key light: bright, from above-front -->
    <light name="key" pos="0 -1.5 3" dir="0 0.4 -1" directional="true"
          diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" castshadow="true"/>
    <!-- fill light: softer, from left side to reduce harsh shadows -->
    <light name="fill" pos="-2 0 2" dir="0.6 0 -0.5" directional="true"
          diffuse="0.4 0.4 0.4" specular="0 0 0" castshadow="false"/>
    <!-- back light: rim effect to separate robot from background -->
    <light name="back" pos="0 2 2.5" dir="0 -0.5 -0.8" directional="true"
          diffuse="0.3 0.35 0.4" specular="0 0 0" castshadow="false"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>
</mujoco>
